{
  "project_shape": "fullstack",
  "language": "Python",
  "frontend": "HTML / CSS / ES modules",
  "prerequisites": [
    "Python >= 3.11",
    "Node.js >= 18（仅构建检查）"
  ],
  "run_command": "python3 -B -m ringtrace --demo",
  "build_command": "python3 -B -m tools.build",
  "testing": "deferred",
  "source_extensions": [
    ".py",
    ".sql",
    ".html",
    ".mjs",
    ".css"
  ],
  "workflow_checks": [
    {
      "workflow_id": "shell",
      "command": "python3 -B -m tools.smoke --through shell"
    },
    {
      "workflow_id": "ingest",
      "command": "python3 -B -m tools.smoke --through ingest"
    },
    {
